# Copia este archivo a .env y ajusta los valores.
# NUNCA subas tu .env real al repositorio.

# --- Base de datos ---
POSTGRES_DB=vertice
POSTGRES_USER=vertice
POSTGRES_PASSWORD=cambia-esta-password

# --- Django ---
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Motor de diagnóstico ---
# Ruta al archivo de conocimiento. El repo incluye solo el ejemplo.
KNOWLEDGE_PATH=/app/engine/knowledge.example.json

# --- Panel del asesor ---
DJANGO_PANEL_PASSWORD=cambia-esta-password-de-panel
